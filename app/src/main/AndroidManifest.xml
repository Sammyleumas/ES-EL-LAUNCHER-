<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Phase 1 requests NO permissions. Each later feature declares and requests
        its own permission only when the user enables that feature.
    -->

    <application
        android:name=".SLLauncherApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SLLauncher">

        <!--
            MainActivity is the launcher's home screen.

            launchMode=singleTask   : one home instance; pressing Home re-delivers
                                      the intent to onNewIntent instead of stacking.
            clearTaskOnLaunch       : returning home always shows the home screen.
            stateNotNeeded          : the system may restart the launcher without
                                      saved state (standard for launchers).
            excludeFromRecents      : the home screen is not shown in Recents.
            resizeableActivity      : supports split-screen / foldables / tablets.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.SLLauncher.Home">

            <!-- Makes SL Launcher eligible to be chosen as the default Home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Also listed in the app drawer so it can be opened before it is the default. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
